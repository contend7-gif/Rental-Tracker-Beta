{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "files": [
    "src/models.ts",
    "src/types/desktop.d.ts",
    "src/app/useDesktopBridgeController.ts",
    "src/app/desktopSaveQueue.ts",
    "src/app/desktopPersistenceHydration.ts"
  ]
}
